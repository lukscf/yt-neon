{
  "manifest_version": 3,
  "name": "YT Neon para YouTube",
  "version": "1.0.0",
  "description": "Tema neon e player flutuante para o YouTube, com velocidade até 4x, volume até 400%, loop A-B, captura de frame, modo foco e mais.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_title": "YT Neon",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-float": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Abrir ou fechar o player flutuante"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "settings.js",
        "bullet-fx.js",
        "float.js",
        "player.js",
        "content.js"
      ],
      "css": [
        "theme.css",
        "effects.css",
        "fonts.css",
        "ui.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
